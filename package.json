{
  "name": "lld-design-review",
  "version": "0.1.0",
  "private": true,
  "description": "DesignReview \u2014 LLD Design Practice & Review Platform",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "lint:fix": "oxlint --fix",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:destroy": "docker compose down -v",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "knowledge:ingest": "tsx --env-file-if-exists=.env prisma/ingest-knowledge.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "groq-sdk": "^1.6.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "oxlint": "^1.85.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
