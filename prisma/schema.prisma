// DesignReview persistence schema.
//
// This schema is an infrastructure detail. The domain model in `src/domain` is
// the source of truth for behaviour and invariants; the tables below exist to
// store it faithfully and to make the queries the application actually performs
// cheap. Enums mirror the domain unions exactly, so an unknown value cannot
// reach the database.
//
// Timestamps the domain owns (attempt, submission, evaluation, problem) are
// plain columns with no `@default(now())` or `@updatedAt`: the clock is injected
// into the application layer, and the database must not silently overwrite it.

generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/persistence/prisma/client"
}

// Prisma 7 keeps the connection URL out of the schema: the CLI reads it from
// `prisma.config.ts` and the client receives a driver adapter instead.
datasource db {
  provider = "postgresql"
}

enum RequirementPriority {
  MUST
  SHOULD
  COULD
}

enum SubmissionFormatType {
  STRUCTURED_DESIGN
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATING
  COMPLETED
  FAILED
}

enum EvaluationStatus {
  PENDING
  EVALUATING
  COMPLETED
  FAILED
}

enum RelationshipType {
  ASSOCIATION
  AGGREGATION
  COMPOSITION
  INHERITANCE
  IMPLEMENTATION
  DEPENDENCY
}

/// Every criterion a stored evaluation may report on.
///
/// The first group is the rubric's semantic criteria, which only a judge can
/// assess. The second is the deterministic set, settled from the submission
/// itself. A problem rubric may only reference the semantic ones; the domain type
/// `Rubric` enforces that, because SQL cannot express a subset of an enum.
enum EvaluationCriterion {
  REQUIREMENT_UNDERSTANDING
  RESPONSIBILITY
  ENCAPSULATION
  COHESION
  COUPLING
  ABSTRACTION
  EXTENSIBILITY
  EDGE_CASES
  DESIGN_REASONING
  TESTABILITY

  STRUCTURAL_VALIDITY
  REQUIREMENT_COVERAGE
  DESIGN_COMPLETENESS
  EDGE_CASE_COVERAGE
  DESIGN_DECISIONS
}

enum CriterionAssessment {
  STRONG
  ADEQUATE
  NEEDS_IMPROVEMENT
  MISSING
}

enum FeedbackPriority {
  P0
  P1
  P2
  P3
}

/// Persistence-only. There is no Learner domain entity and no authentication:
/// the MVP runs with one seeded learner. The table exists so attempt ownership
/// is a real foreign key rather than an unchecked string.
model Learner {
  id          String   @id
  displayName String
  createdAt   DateTime @default(now())

  attempts Attempt[]

  @@map("learners")
}

model Problem {
  id                        String                 @id
  slug                      String                 @unique
  title                     String
  description               String
  context                   String
  constraints               String[]
  acceptedSubmissionFormats SubmissionFormatType[]
  version                   Int
  createdAt                 DateTime
  updatedAt                 DateTime

  requirements Requirement[]
  rubric       ProblemRubric?
  attempts     Attempt[]

  @@map("problems")
}

model Requirement {
  id          String              @id
  problemId   String
  code        String
  title       String
  description String
  priority    RequirementPriority
  position    Int

  problem             Problem                    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  requirementMappings DesignRequirementMapping[]

  @@unique([problemId, code])
  @@index([problemId])
  @@map("requirements")
}

model ProblemRubric {
  id        String @id @default(uuid())
  problemId String @unique
  version   String

  problem  Problem           @relation(fields: [problemId], references: [id], onDelete: Cascade)
  criteria RubricCriterion[]

  @@map("problem_rubrics")
}

model RubricCriterion {
  id        String              @id @default(uuid())
  rubricId  String
  criterion EvaluationCriterion
  weight    Float
  guidance  String
  position  Int

  rubric ProblemRubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  @@unique([rubricId, criterion])
  @@index([rubricId])
  @@map("rubric_criteria")
}

model Attempt {
  id                  String        @id
  problemId           String
  learnerId           String
  attemptNumber       Int
  status              AttemptStatus
  draftDesignId       String?       @unique
  /// Deliberately not a foreign key: submissions already own their attempt, and
  /// a second key in the opposite direction would make attempts and submissions
  /// circularly dependent. It is written in the same transaction as the
  /// submission it points at.
  currentSubmissionId String?
  createdAt           DateTime
  updatedAt           DateTime
  submittedAt         DateTime?
  completedAt         DateTime?

  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  learner     Learner      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  draftDesign Design?      @relation(fields: [draftDesignId], references: [id], onDelete: SetNull)
  submissions Submission[]

  @@unique([learnerId, problemId, attemptNumber])
  @@index([learnerId, problemId])
  @@index([problemId])
  @@index([status])
  @@map("attempts")
}

/// One structured design. A design is owned either by an attempt (its mutable
/// draft) or by a submission (an immutable snapshot); a submission never shares
/// a row with a draft, so submitted work cannot be edited through the draft.
model Design {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  classes             DesignClass[]
  interfaces          DesignInterface[]
  relationships       DesignRelationship[]
  decisions           DesignDecision[]
  edgeCases           DesignEdgeCase[]
  requirementMappings DesignRequirementMapping[]
  draftOfAttempt      Attempt?
  submission          Submission?

  @@map("designs")
}

model DesignClass {
  id             String @id @default(uuid())
  designId       String
  /// The id the learner or the submission normalizer assigned, e.g. `class-1`.
  elementId      String
  name           String
  responsibility String
  /// Ordered leaf lists of `{ name, type? }` and `{ name, signature?,
  /// description? }`. They are never queried on their own, are always read with
  /// their owning element, and their only invariant (a non-empty name) is
  /// enforced by domain validation, so two extra tables and two extra joins per
  /// element would buy no integrity or queryability.
  attributes     Json
  methods        Json
  position       Int

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, name])
  @@index([designId])
  @@map("design_classes")
}

model DesignInterface {
  id             String @id @default(uuid())
  designId       String
  elementId      String
  name           String
  responsibility String
  methods        Json
  position       Int

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, name])
  @@index([designId])
  @@map("design_interfaces")
}

model DesignRelationship {
  id          String           @id @default(uuid())
  designId    String
  /// Endpoints reference design elements by name, matching how evaluation
  /// evidence addresses them. The element must exist in the same design, which
  /// domain validation checks; SQL cannot express it across two element tables.
  source      String
  target      String
  type        RelationshipType
  cardinality String?
  rationale   String?
  position    Int

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, source, target, type])
  @@index([designId])
  @@map("design_relationships")
}

model DesignDecision {
  id        String @id @default(uuid())
  designId  String
  decision  String
  rationale String
  tradeoff  String
  position  Int

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
  @@map("design_decisions")
}

model DesignEdgeCase {
  id               String @id @default(uuid())
  designId         String
  description      String
  expectedBehavior String
  position         Int

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
  @@map("design_edge_cases")
}

model DesignRequirementMapping {
  id            String  @id @default(uuid())
  designId      String
  requirementId String
  note          String?
  position      Int

  design      Design                              @relation(fields: [designId], references: [id], onDelete: Cascade)
  requirement Requirement                         @relation(fields: [requirementId], references: [id])
  references  DesignRequirementMappingReference[]

  @@index([designId])
  @@index([requirementId])
  @@map("design_requirement_mappings")
}

model DesignRequirementMappingReference {
  id        String  @id @default(uuid())
  mappingId String
  entity    String
  field     String?
  value     String?
  position  Int

  mapping DesignRequirementMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@index([mappingId])
  @@map("design_requirement_mapping_references")
}

model Submission {
  id         String               @id
  attemptId  String
  version    Int
  formatType SubmissionFormatType
  designId   String               @unique
  createdAt  DateTime

  attempt     Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  design      Design       @relation(fields: [designId], references: [id])
  evaluations Evaluation[]

  @@unique([attemptId, version])
  @@index([attemptId])
  @@map("submissions")
}

model Evaluation {
  id               String           @id
  submissionId     String
  status           EvaluationStatus
  /// Versioned so a stored result can be explained after prompts, rubrics or the
  /// knowledge base move on.
  evaluatorVersion String
  rubricVersion    String
  promptVersion    String
  knowledgeVersion String
  /// Which model produced the semantic part of this evaluation, where one did.
  /// Never holds a credential: the provider name and the model id only.
  provider         String?
  model            String?
  idempotencyKey   String           @unique
  attemptCount     Int
  /// Outcome columns are null until the evaluation completes. `strengths` is a
  /// plain ordered list of sentences with no attributes of its own, so it stays
  /// a Postgres text array rather than a table.
  summary          String?
  confidence       Float?
  strengths        String[]
  failureCode      String?
  failureMessage   String?
  createdAt        DateTime
  updatedAt        DateTime
  startedAt        DateTime?
  completedAt      DateTime?

  submission       Submission                  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterionResults EvaluationCriterionResult[]
  feedbackItems    EvaluationFeedbackItem[]

  @@index([submissionId])
  @@index([status])
  @@map("evaluations")
}

model EvaluationCriterionResult {
  id                      String              @id @default(uuid())
  evaluationId            String
  criterion               EvaluationCriterion
  assessment              CriterionAssessment
  concern                 String?
  suggestion              String?
  confidence              Float?
  /// How many evidence references were discarded because they could not be found
  /// in the submitted design. Null where evidence was never checked.
  unverifiedEvidenceCount Int?
  position                Int

  evaluation Evaluation                    @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evidence   EvaluationCriterionEvidence[]

  @@unique([evaluationId, criterion])
  @@index([evaluationId])
  @@map("evaluation_criterion_results")
}

model EvaluationCriterionEvidence {
  id                String  @id @default(uuid())
  criterionResultId String
  entity            String
  field             String?
  value             String?
  position          Int

  criterionResult EvaluationCriterionResult @relation(fields: [criterionResultId], references: [id], onDelete: Cascade)

  @@index([criterionResultId])
  @@map("evaluation_criterion_evidence")
}

model EvaluationFeedbackItem {
  id           String               @id
  evaluationId String
  priority     FeedbackPriority
  criterion    EvaluationCriterion?
  /// Machine-readable reason the item exists, so a benchmark can count findings
  /// without parsing prose. Deterministic findings always set it.
  code         String?
  what         String
  why          String
  reconsider   String?
  position     Int

  evaluation Evaluation                   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evidence   EvaluationFeedbackEvidence[]

  @@index([evaluationId])
  @@map("evaluation_feedback_items")
}

model EvaluationFeedbackEvidence {
  id             String  @id @default(uuid())
  feedbackItemId String
  entity         String
  field          String?
  value          String?
  position       Int

  feedbackItem EvaluationFeedbackItem @relation(fields: [feedbackItemId], references: [id], onDelete: Cascade)

  @@index([feedbackItemId])
  @@map("evaluation_feedback_evidence")
}
