# Copy to `.env` before running any database command:
#   cp .env.example .env
#
# The defaults match docker-compose.yml, so they work as-is against the local
# container. Never commit a filled-in `.env`.

# --- Database (milestone 2) ---------------------------------------------------
DATABASE_URL="postgresql://designreview:designreview@localhost:5433/designreview?schema=public"
# Separate database used only by integration tests; they truncate every table.
TEST_DATABASE_URL="postgresql://designreview:designreview@localhost:5433/designreview_test?schema=public"

# Consumed by docker-compose.yml. Change these together with the URLs above.
POSTGRES_USER="designreview"
POSTGRES_PASSWORD="designreview"
POSTGRES_DB="designreview"
POSTGRES_TEST_DB="designreview_test"
POSTGRES_PORT="5433"

# --- Language model (milestone 4) --------------------------------------------
# Optional. With both of these unset the application runs the deterministic
# evaluator alone and every test still passes; set them to enable AI review.
GROQ_API_KEY=""

# Optional. Defaults to llama-3.3-70b-versatile (Llama 3.3 70B on Groq), declared
# once in src/infrastructure/ai/groq-config.ts. Set this to override it — for
# example if that id is retired. To see the ids this key can actually use:
#
#   curl -sH "Authorization: Bearer $GROQ_API_KEY" \
#     https://api.groq.com/openai/v1/models | jq -r '.data[].id'
GROQ_MODEL=""

# Optional. Hard ceiling for one model call, and how many times the SDK retries.
GROQ_TIMEOUT_MS="45000"
GROQ_MAX_RETRIES="1"

# --- Embeddings for the knowledge base (milestone 5) -------------------------
# Required in production. Optional for development and tests.
#
# Any service speaking the OpenAI-compatible POST /v1/embeddings contract works,
# including a local Ollama or LM Studio server, so switching provider is a base
# URL rather than a code change.
#
# With a key set, retrieval is semantic.
#
# With no key, behaviour depends on NODE_ENV:
#   NODE_ENV=production  -> startup fails with EmbeddingConfigurationError.
#   anything else        -> local lexical embeddings, so ingestion, retrieval and
#                           the tests run offline at no cost.
#
# Production MUST NOT fall back to lexical retrieval. Lexical vectors match on word
# overlap, so a deployment missing its key would keep returning ranked, cited
# passages chosen on a different basis than the one it claims, with nothing in the
# result or the database to reveal it. That is why a missing key in production is an
# error rather than a mode. To run offline against a production build, point
# EMBEDDING_BASE_URL at a local embedding service and give it any non-empty key.
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL="https://api.openai.com/v1"

# Optional. Defaults to text-embedding-3-small, declared once in
# src/infrastructure/ai/embedding-config.ts. To see what a key can use:
#
#   curl -sH "Authorization: Bearer $EMBEDDING_API_KEY" \
#     "$EMBEDDING_BASE_URL/models" | jq -r '.data[].id'
EMBEDDING_MODEL=""

# Optional. Must equal the width of the knowledge_chunks.embedding column, which
# is fixed by migration — changing it needs a migration and a re-ingestion.
EMBEDDING_DIMENSIONS="1536"
EMBEDDING_TIMEOUT_MS="30000"
